{
  "description": "ai-dev-rules hooks",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"{{HOME}}/.codex/hooks/block-dangerous.ps1\" -Tool codex",
            "timeout": 30,
            "statusMessage": "ai-dev-rules: checking command"
          }
        ]
      }
    ]
  }
}
