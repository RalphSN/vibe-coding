{
  "ai-dev-rules": {
    "PreToolUse": [
      {
        "matcher": "run_command|view_file|write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "{{PS}} -NoProfile -ExecutionPolicy Bypass -File \"{{HOME}}/.gemini/config/hooks/block-dangerous.ps1\" -Tool antigravity",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
