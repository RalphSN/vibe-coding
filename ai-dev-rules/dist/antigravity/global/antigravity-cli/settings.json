{
  "permissions": {
    "deny": [
      "read_file(.env)",
      "read_file(.env.local)",
      "read_file(.env.production)",
      "read_file(.env.development)",
      "write_file(.env)",
      "write_file(.git/)",
      "command(regex:git\\s+push\\s+.*(--force|-f\\b).*)",
      "command(regex:rm\\s+-(rf|fr)\\b.*)",
      "command(regex:Remove-Item\\s+.*-Recurse.*-Force.*)"
    ],
    "ask": [
      "command(regex:git\\s+push\\b.*)",
      "command(regex:git\\s+reset\\s+--hard.*)",
      "command(regex:git\\s+clean\\b.*)"
    ]
  }
}
